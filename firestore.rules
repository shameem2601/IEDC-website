rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events: readable by all, writable by authenticated users
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Registrations: users can read their own or all public attendance counts, write their own
    match /event_registrations/{regId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Applications & Startup pitches
    match /applications/{appId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Contact inquiries & messages
    match /inquiries/{inquiryId} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    // User profiles & bookmarks
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
